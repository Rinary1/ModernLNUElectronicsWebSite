@using ModernLNUElectronicsWebSite.Scraping

@if (Page is null)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
        Текст цієї сторінки ще не перенесено в дзеркало.
        @if (SourceUrl is not null)
        {
            <MudLink Href="@SourceUrl" Target="_blank" rel="noopener noreferrer">Відкрити оригінал ↗</MudLink>
        }
    </MudAlert>
}
else
{
    <article class="article">
        @if (ShowTitle)
        {
            <MudText Typo="Typo.h4" Class="fw-600 mb-2">@Page.Title</MudText>
        }

        @if (Page.RawDate is { Length: > 0 } date)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-4">@date</MudText>
        }

        @if (Page.CoverImageUrl is { Length: > 0 } cover)
        {
            <img class="article__cover" src="@cover" alt="@Page.Title" loading="lazy" />
        }

        <div class="article__body">
            @((MarkupString)Page.BodyHtml)
        </div>

        <MudDivider Class="my-6" />
        <SourceLink Url="@Page.SourceUrl" />
    </article>
}

@code {
    [Parameter]
    public MirrorPage? Page { get; set; }

    [Parameter]
    public string? SourceUrl { get; set; }

    [Parameter]
    public bool ShowTitle { get; set; } = true;
}
