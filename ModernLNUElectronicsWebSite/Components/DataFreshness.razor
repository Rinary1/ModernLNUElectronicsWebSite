@using ModernLNUElectronicsWebSite.Data
@inject MirrorContentClient Content

@if (_meta is not null)
{
    <span class="data-freshness" title="@_meta.GeneratedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")">
        Дані оновлено @Ago(_meta.GeneratedAt)
    </span>
}

@code {
    private MirrorMeta? _meta;

    protected override async Task OnInitializedAsync() => _meta = await Content.TryGetMetaAsync();

    private static string Ago(DateTime utc)
    {
        var span = DateTime.UtcNow - utc;

        return span switch
        {
            { TotalMinutes: < 2 } => "щойно",
            { TotalHours: < 1 } => $"{(int)span.TotalMinutes} хв тому",
            { TotalHours: < 24 } => $"{(int)span.TotalHours} год тому",
            { TotalDays: < 30 } => $"{(int)span.TotalDays} дн тому",
            _ => utc.ToLocalTime().ToString("dd.MM.yyyy"),
        };
    }
}
