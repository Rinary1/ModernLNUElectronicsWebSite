@page "/staff"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using ModernLNUElectronicsWebSite.Scraping
@inject HttpClient Http

<PageTitle>Співробітники - Факультет Електроніки ЛНУ</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true" Class="fw-600">Співробітники</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Зведений список з <code>/about/staff/</code> оригінального сайту (16 підрозділів).
</MudText>

<MudTextField T="string"
              Value="_query"
              ValueChanged="OnQueryChanged"
              Immediate="true"
              DebounceInterval="250"
              Placeholder="Пошук за прізвищем, посадою або поштою..."
              Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search"
              Clearable="true"
              Variant="Variant.Outlined"
              Margin="Margin.Dense"
              Class="mb-4" />

@if (_busy)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}
else if (_note is not null)
{
    <MudAlert Severity="@_noteSeverity" Dense="true" Class="mb-4">@_note</MudAlert>
}
else
{
    <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2">
        Показано @_shown із @_all.Count
    </MudText>

    @if (_rows.Count == 0)
    {
        <MudText Class="mt-6" Color="Color.Secondary">За запитом "@_query" нікого не знайдено.</MudText>
    }
    else
    {
        <Virtualize Items="_rows" ItemSize="61" OverscanCount="8" Context="row">
            @if (row is HeaderRow h)
            {
                <div class="staff-row staff-row--header">
                    <MudText Typo="Typo.subtitle1" Class="fw-600">@h.Title</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">· @h.Count</MudText>
                    @if (h.Url is not null)
                    {
                        <span class="staff-row__deptlink">
                            <MudLink Href="@h.Url" Target="_blank" rel="noopener" Typo="Typo.caption">
                                підрозділ ↗
                            </MudLink>
                        </span>
                    }
                </div>
            }
            else if (row is PersonRow pr)
            {
                <div class="staff-row">
                    <div class="staff-row__main">
                        <div class="d-flex align-center gap-2">
                            <MudLink Href="@pr.Person.ProfileUrl" Target="_blank" rel="noopener" Typo="Typo.body1">
                                @pr.Person.FullName
                            </MudLink>
                            @if (pr.Person.IsExternal)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                                         Variant="Variant.Text" Class="ma-0">сумісник</MudChip>
                            }
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@pr.Person.Position</MudText>
                    </div>
                    @if (pr.Person.Email is not null)
                    {
                        <span class="staff-row__email d-none d-sm-flex align-center gap-1">
                            <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Color="Color.Secondary" />
                            <MudLink Href="@($"mailto:{pr.Person.Email}")" Typo="Typo.caption">@pr.Person.Email</MudLink>
                        </span>
                    }
                </div>
            }
        </Virtualize>
    }
}

@code {
    [Parameter]
    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    private abstract record Row;
    private sealed record HeaderRow(string Title, string? Url, int Count) : Row;
    private sealed record PersonRow(StaffItem Person) : Row;

    private sealed record Group(string Title, string? Url, List<StaffItem> People);

    private readonly List<StaffItem> _all = new();
    private List<Group> _groups = new();
    private List<Row> _rows = new();
    private int _shown;

    private string? _query;
    private string? _note;
    private Severity _noteSeverity = Severity.Info;
    private bool _busy = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var items = await Http.GetFromJsonAsync<List<StaffItem>>("data/staff.json");
            _all.AddRange(items ?? new());

            _groups = _all
                .GroupBy(s => s.Group.Title)
                .Select(g => new Group(g.Key, g.First().Group.Url, g.ToList()))
                .ToList();

            _query = string.IsNullOrWhiteSpace(Q) ? null : Q;
            Rebuild();
        }
        catch (HttpRequestException)
        {
            _note = "data/staff.json ще немає - його має згенерувати GitHub Action " +
                    "(dotnet run --project tools/Scraper).";
            _noteSeverity = Severity.Info;
        }
        catch (Exception ex)
        {
            _note = $"Не вдалося прочитати staff.json: {ex.Message}";
            _noteSeverity = Severity.Error;
        }
        finally
        {
            _busy = false;
        }
    }

    private void OnQueryChanged(string? value)
    {
        _query = value;
        Rebuild();
    }

    private void Rebuild()
    {
        var q = _query?.Trim();
        var rows = new List<Row>();

        foreach (var group in _groups)
        {
            var people = string.IsNullOrEmpty(q)
                ? group.People
                : group.People.Where(p => Matches(p, q)).ToList();

            if (people.Count == 0)
                continue;

            rows.Add(new HeaderRow(group.Title, group.Url, people.Count));
            rows.AddRange(people.Select(p => new PersonRow(p)));
        }

        _rows = rows;
        _shown = rows.Count(r => r is PersonRow);
    }

    private static bool Matches(StaffItem p, string q) =>
        p.FullName.Contains(q, StringComparison.OrdinalIgnoreCase)
        || p.Position.Contains(q, StringComparison.OrdinalIgnoreCase)
        || p.Group.Title.Contains(q, StringComparison.OrdinalIgnoreCase)
        || (p.Email?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false);
}
