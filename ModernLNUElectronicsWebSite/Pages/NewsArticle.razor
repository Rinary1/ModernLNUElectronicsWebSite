@page "/news/{Slug}"
@using ModernLNUElectronicsWebSite.Content
@using ModernLNUElectronicsWebSite.Data
@inject MirrorContentClient Content

<PageMeta Title="@(_page?.Title ?? "Новина")"
          Description="@Summary"
          Canonical="@SourceUrl"
          IsArticle="true" />

<MudButton Href="news" Variant="Variant.Text" Color="Color.Primary" Class="mb-4"
           StartIcon="@Icons.Material.Filled.ArrowBack">
    Усі новини
</MudButton>

@if (_busy)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}
else
{
    <MirrorArticleView Page="_page" SourceUrl="@SourceUrl" FallbackTitle="Новина" />
}

@code {
    [Parameter]
    public string Slug { get; set; } = string.Empty;

    private MirrorPage? _page;
    private bool _busy = true;

    private string SourceUrl => $"{SiteUrls.Origin}/news/{Slug}/";

    private string? Summary => MetaText.Summarize(_page?.PlainText);

    protected override async Task OnParametersSetAsync()
    {
        _busy = true;
        _page = await Content.TryGetNewsAsync(Slug);
        _busy = false;
    }
}
