@page "/schedule"
@using System.Net.Http.Json
@using ModernLNUElectronicsWebSite.Scraping
@inject HttpClient Http

<PageTitle>Розклад - Факультет Електроніки ЛНУ</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true" Class="fw-600">Розклад</MudText>

<MudPaper Outlined="true" Class="pa-4 mb-6">
    <MudText Typo="Typo.h6" Class="fw-600 mb-1">Розклад занять</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
        Актуальний розклад пар веде деканат в окремій системі. Оберіть там
        «Факультет електроніки та комп'ютерних технологій», курс і групу.
    </MudText>
    <MudButton Href="https://dekanat.lnu.edu.ua/cgi-bin/timetable.cgi"
               Target="_blank" rel="noopener"
               Variant="Variant.Filled" Color="Color.Primary"
               EndIcon="@Icons.Material.Filled.OpenInNew">
        Відкрити розклад деканату
    </MudButton>
</MudPaper>

<MudText Typo="Typo.h6" Class="fw-600 mb-2">Іспити, заліки, графіки (PDF)</MudText>

@if (_busy)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}
else if (_note is not null)
{
    <MudAlert Severity="@_noteSeverity" Dense="true" Class="mb-4">@_note</MudAlert>
}
else if (_docs.Count == 0)
{
    <MudText Color="Color.Secondary">Документів поки немає.</MudText>
}
else
{
    @foreach (var group in _docs.GroupBy(d => d.Section))
    {
        <div class="mt-4">
            <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-1">@group.Key</MudText>
            <MudList T="string" Dense="true" Class="pa-0">
                @foreach (var doc in group)
                {
                    <MudListItem T="string" Icon="@Icons.Material.Filled.PictureAsPdf"
                                 Href="@doc.Url" Target="_blank" rel="noopener">
                        <MudText Typo="Typo.body2">@doc.Title</MudText>
                    </MudListItem>
                }
            </MudList>
        </div>
    }

    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-4 d-block">
        Джерело:
        <MudLink Href="https://electronics.lnu.edu.ua/students/rozklad-format-pdf/" Target="_blank"
                 rel="noopener" Typo="Typo.caption">students/rozklad-format-pdf ↗</MudLink>
    </MudText>
}

@code {
    private readonly List<ScheduleDoc> _docs = new();
    private string? _note;
    private Severity _noteSeverity = Severity.Info;
    private bool _busy = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var items = await Http.GetFromJsonAsync<List<ScheduleDoc>>("data/schedule.json");
            _docs.AddRange(items ?? new());
        }
        catch (HttpRequestException)
        {
            _note = "data/schedule.json ще не згенеровано (dotnet run --project tools/Scraper).";
            _noteSeverity = Severity.Warning;
        }
        catch (Exception ex)
        {
            _note = $"Не вдалося прочитати schedule.json: {ex.Message}";
            _noteSeverity = Severity.Error;
        }
        finally
        {
            _busy = false;
        }
    }
}
