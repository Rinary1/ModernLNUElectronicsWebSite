@page "/"
@using System.Net.Http.Json
@using ModernLNUElectronicsWebSite.Scraping
@inject HttpClient Http

<PageTitle>Головна - Факультет Електроніки ЛНУ</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true" Class="fw-600">Факультет електроніки та комп'ютерних технологій</MudText>
<MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
    Зручне дзеркало офіційного сайту: та сама інформація, але з пошуком, темами й нормальною версткою на великих екранах.
</MudText>

<MudGrid>
    @foreach (var card in _cards)
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard Outlined="true" Class="h-100">
                <MudCardContent>
                    <MudIcon Icon="@card.Icon" Color="Color.Primary" Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.h6">@card.Title</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@card.Text</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Href="@card.Href">Перейти</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    }
</MudGrid>

@if (_busy)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-10 my-4" />
}

@if (_note is not null)
{
    <MudAlert Severity="@_noteSeverity" Class="mt-10 mb-4" Dense="true">@_note</MudAlert>
}

@if (_items.Count > 0)
{
    <MudText Typo="Typo.h5" Class="mt-10 mb-3 fw-600">Останні новини</MudText>
    <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-2">
        Новин: @_items.Count@(_nextPage is not null ? $"  ·  наступна сторінка: {_nextPage}" : string.Empty)
    </MudText>

    @foreach (var item in _items)
    {
        <MudPaper Outlined="true" Class="pa-4 mb-3">
            <MudLink Href="@item.Url" Target="_blank" rel="noopener" Typo="Typo.subtitle1">@item.Title</MudLink>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">
                @(item.PublishedAt?.ToString("dd.MM.yyyy HH:mm") ?? item.RawDate)
            </MudText>
            @if (item.Excerpt is not null)
            {
                <MudText Typo="Typo.body2" Class="mt-2">@item.Excerpt</MudText>
            }
        </MudPaper>
    }
}

@code {
    private readonly List<NewsItem> _items = new();
    private string? _nextPage;
    private string? _note;
    private Severity _noteSeverity = Severity.Info;
    private bool _busy;

    private record CardInfo(string Title, string Text, string Icon, string Href);

    private readonly CardInfo[] _cards =
    {
        new("Кафедри", "Склад, напрями роботи та контакти кафедр факультету.", Icons.Material.Filled.AccountBalance, "departments/radiophysics"),
        new("Співробітники", "Викладачі й наукові співробітники з пошуком за прізвищем.", Icons.Material.Filled.Groups, "staff"),
        new("Розклад", "Актуальний розклад занять у зручному вигляді.", Icons.Material.Filled.CalendarMonth, "schedule"),
        new("Абітурієнту", "Спеціальності, вступ, підготовчі курси.", Icons.Material.Filled.School, "applicants"),
        new("Наука", "Дослідження, публікації, конференції.", Icons.Material.Filled.Science, "science"),
        new("Контакти", "Адреса, телефони, як дістатися.", Icons.Material.Filled.Place, "contacts"),
    };

    protected override Task OnInitializedAsync() => LoadGeneratedJsonAsync();

    private Task LoadGeneratedJsonAsync() => RunAsync(async () =>
    {
        try
        {
            var items = await Http.GetFromJsonAsync<List<NewsItem>>("data/news.json");
            _items.AddRange(items ?? new());
        }
        catch (HttpRequestException)
        {
            Set("data/news.json ще немає - його має згенерувати GitHub Action (.github/workflows/scrape-news.yml).",
                Severity.Info);
        }
    });

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _note = null;
        _items.Clear();
        _nextPage = null;
        try
        {
            await action();
        }
        catch (Exception ex) when (_note is null)
        {
            Set(ex.Message, Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void Fill(NewsPage page)
    {
        _items.AddRange(page.Items);
        _nextPage = page.NextPageUrl;
    }

    private void Set(string message, Severity severity)
    {
        _note = message;
        _noteSeverity = severity;
    }
}
