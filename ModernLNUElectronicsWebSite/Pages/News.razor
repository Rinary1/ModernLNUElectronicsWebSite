@page "/news"
@using System.Net.Http.Json
@using ModernLNUElectronicsWebSite.Scraping
@inject HttpClient Http

<PageTitle>Новини - Факультет Електроніки ЛНУ</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true" Class="fw-600">Новини та події</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Стрічка з оригінального сайту факультету. Оновлюється автоматично.
</MudText>

@if (_busy)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}
else if (_note is not null)
{
    <MudAlert Severity="@_noteSeverity" Dense="true" Class="mb-4">@_note</MudAlert>
}
else
{
    <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Class="mb-3">@_items.Count новин</MudText>

    @foreach (var item in _items)
    {
        <MudPaper Outlined="true" Class="pa-3 mb-2">
            <div class="d-flex align-start gap-2">
                <MudLink Href="@($"news/{item.Slug}")" Typo="Typo.subtitle1" Class="flex-grow-1">@item.Title</MudLink>
                <MudTooltip Text="Оригінал новини на сайті факультету" Arrow="true">
                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small"
                                   Href="@item.Url" Target="_blank" rel="noopener noreferrer"
                                   aria-label="Відкрити оригінал" />
                </MudTooltip>
            </div>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">
                @(item.PublishedAt?.ToString("dd.MM.yyyy HH:mm") ?? item.RawDate)
            </MudText>
            @if (item.Excerpt is not null)
            {
                <MudText Typo="Typo.body2" Class="mt-2">@item.Excerpt</MudText>
            }
        </MudPaper>
    }

    <SourceLink Url="https://electronics.lnu.edu.ua/news/" Class="mt-4"
                Prefix="Стрічка-джерело:" Label="Уся стрічка на оригінальному сайті" />
}

@code {
    private readonly List<NewsItem> _items = new();
    private string? _note;
    private Severity _noteSeverity = Severity.Info;
    private bool _busy = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var items = await Http.GetFromJsonAsync<List<NewsItem>>("data/news.json");
            _items.AddRange(items ?? new());

            if (_items.Count == 0)
            {
                _note = "Новин поки немає.";
                _noteSeverity = Severity.Info;
            }
        }
        catch (HttpRequestException)
        {
            _note = "data/news.json ще не згенеровано (GitHub Action / dotnet run --project tools/Scraper).";
            _noteSeverity = Severity.Warning;
        }
        catch (Exception ex)
        {
            _note = $"Не вдалося прочитати news.json: {ex.Message}";
            _noteSeverity = Severity.Error;
        }
        finally
        {
            _busy = false;
        }
    }
}
