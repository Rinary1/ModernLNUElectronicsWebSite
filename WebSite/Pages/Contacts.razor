@page "/contacts"

<PageMeta Title="Контакти"
          Description="Адреса, телефони, пошта та розташування факультету електроніки та комп'ютерних технологій ЛНУ ім. Івана Франка на карті." />

<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true" Class="fw-600">Контакти</MudText>

<MudGrid Spacing="4">
    <MudItem xs="12" md="5">
        <MudText Typo="Typo.h6" HtmlTag="h2" Class="fw-600">Факультет електроніки та комп'ютерних технологій</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            Львівський національний університет імені Івана Франка
        </MudText>

        <MudList T="string" Dense="true" Class="pa-0">
            <MudListItem T="string" Icon="@Icons.Material.Filled.Place">
                <MudText Typo="Typo.body2">вул. Драгоманова, 50<br />Львів, 79005, Україна</MudText>
            </MudListItem>

            <MudDivider Class="my-1" />

            <MudListItem T="string" Icon="@Icons.Material.Filled.Call">
                <div class="d-flex flex-column">
                    <MudLink Href="tel:+380322394724" Typo="Typo.body2">(032) 239 47 24</MudLink>
                    <MudLink Href="tel:+380322394182" Typo="Typo.body2">(032) 239 41 82</MudLink>
                </div>
            </MudListItem>

            <MudDivider Class="my-1" />

            <MudListItem T="string" Icon="@Icons.Material.Filled.Email">
                <MudLink Href="mailto:electronics.faculty@lnu.edu.ua" Typo="Typo.body2">
                    electronics.faculty@lnu.edu.ua
                </MudLink>
            </MudListItem>

            <MudDivider Class="my-1" />

            <MudListItem T="string" Icon="@Icons.Material.Filled.Language">
                <MudLink Href="https://electronics.lnu.edu.ua/" Target="_blank" rel="noopener" Typo="Typo.body2">
                    electronics.lnu.edu.ua
                </MudLink>
            </MudListItem>
        </MudList>
    </MudItem>

    <MudItem xs="12" md="7">
        <div class="contacts-map">
            <iframe title="Розташування головного корпусу на карті"
                    src="https://www.openstreetmap.org/export/embed.html?bbox=24.0238%2C49.8304%2C24.0308%2C49.8340&layer=mapnik&marker=49.8322%2C24.0273"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>

        <div class="d-flex gap-4 mt-2">
            <MudLink Href="https://www.openstreetmap.org/?mlat=49.8322&mlon=24.0273#map=17/49.8322/24.0273"
                     Target="_blank" rel="noopener" Typo="Typo.caption">
                Відкрити в OpenStreetMap ↗
            </MudLink>
            <MudLink Href="https://www.google.com/maps/search/?api=1&query=49.8322,24.0273"
                     Target="_blank" rel="noopener" Typo="Typo.caption">
                Відкрити в Google Maps ↗
            </MudLink>
        </div>
    </MudItem>
</MudGrid>
