@page "/schedule"
@using System.Net.Http.Json
@using WebSite.Data
@inject HttpClient Http
@inject MirrorContentClient Content
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageMeta Title="@PageName"
          Description="Розклад занять і сесії факультету електроніки та комп'ютерних технологій ЛНУ: розібраний з PDF у таблицю, з вибором своєї групи." />

<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true" Class="fw-600">Розклад</MudText>

<MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">
    Цей сайт є дзеркалом, це значить що розклад має "відставання", воно є приблизно 6 годин, це означає що останні зміни на сайті деканату можуть ще не відобразитися тут. 
    Також цей розклад є розібраним з PDF у таблицю, тому деякі деталі можуть бути втрачені. Також точність падає оскільки деканат передає не точний PDF, помилки у PDF вже були з розкладом англійської мови.
    Завжди перевіряйте актуальність розкладу на сайті деканату. Це не є першоджерело, а лише зручний інтерфейс для перегляду розкладу.
    <MudLink Href="https://dekanat.lnu.edu.ua/cgi-bin/timetable.cgi" Target="_blank" rel="noopener">
        Відкрити розклад деканату ↗
    </MudLink>
</MudAlert>

@if (_busy)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}
else
{
    @if (_groups.Count > 0)
    {
        <MudPaper Outlined="true" Class="pa-4 mb-6">
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="fw-600 mb-1">Мій розклад</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                Оберіть групу - покажемо тиждень занять і дати сесії текстом, без PDF.
            </MudText>

            <MudAutocomplete T="string"
                             Value="Group"
                             ValueChanged="SelectGroupAsync"
                             SearchFunc="SearchGroupsAsync"
                             Label="Група"
                             Placeholder="Наприклад, ФЕІ-11с"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Clearable="true"
                             MaxItems="20"
                             CoerceValue="false" />
        </MudPaper>
    }

    @if (Group is { Length: > 0 } group)
    {
        @if (_weekly is null && _exams.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-6">
                Для групи "@group" розібраного розкладу немає - подивіться документи нижче.
            </MudAlert>
        }

        @if (_weekly is { } week)
        {
            <MudText Typo="Typo.h5" HtmlTag="h2" Class="fw-600 mb-1">@group · тиждень</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-4">
                @week.Table.Title ·
                <MudLink Href="@week.Table.Url" Target="_blank" rel="noopener" Typo="Typo.caption">PDF-оригінал ↗</MudLink>
            </MudText>

            @foreach (var day in week.Days)
            {
                <section class="day mb-6">
                    <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="fw-600 mb-1">@day.Key</MudText>

                    @foreach (var row in day)
                    {
                        <div class="lesson">
                            <div class="lesson__when">
                                <span class="lesson__pair">@row.Pair пара</span>
                                <span class="lesson__time">@row.Time</span>
                            </div>
                            <div class="lesson__what">
                                @foreach (var part in Parts(row.CellOf(week.Column)))
                                {
                                    <p>@part</p>
                                }
                            </div>
                        </div>
                    }
                </section>
            }
        }

        @if (_exams.Count > 0)
        {
            <MudText Typo="Typo.h5" HtmlTag="h2" Class="fw-600 mt-8 mb-3">@group · сесія</MudText>

            @foreach (var exam in _exams)
            {
                <div class="exam">
                    <span class="exam__when">@exam.When</span>
                    <span class="exam__what">@exam.What</span>
                </div>
            }
        }

        <MudDivider Class="my-8" />
    }

    <MudText Typo="Typo.h5" HtmlTag="h2" Class="fw-600 mb-1">Усі документи</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
        Те, що деканат виклав на сайт факультету. Розібрані в таблицю позначені.
    </MudText>

    @if (_note is not null)
    {
        <MudAlert Severity="@_noteSeverity" Dense="true" Class="mb-4">@_note</MudAlert>
    }

    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true">
        @foreach (var category in Categories)
        {
            var docs = _docs.Where(d => d.Category == category.Kind).ToList();

            <MudTabPanel Text="@category.Title" Icon="@category.Icon" BadgeData="@docs.Count">

                @if (docs.Count == 0)
                {
                    <MudText Class="mud-text-secondary">Документів у цьому розділі поки немає.</MudText>
                }
                else
                {
                    @foreach (var section in docs.GroupBy(d => d.Section))
                    {
                        <div class="mb-5">
                            <MudText Typo="Typo.subtitle2" Color="Color.Primary" Class="mb-1">@section.Key</MudText>

                            @foreach (var doc in section)
                            {
                                <div class="schedule-doc">
                                    <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Small"
                                             Class="mud-text-secondary" />
                                    <MudLink Href="@doc.Url" Target="_blank" rel="noopener noreferrer"
                                             Typo="Typo.body2" Class="flex-grow-1">@doc.Title</MudLink>

                                    @if (_parsed.TryGetValue(SiteUrls.PdfSlug(doc.Url), out var groups))
                                    {
                                        <MudTooltip Arrow="true" Text="@($"Розібрано в таблицю: {string.Join(", ", groups)}")">
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                                     Color="Color.Success" Class="ma-0">таблиця</MudChip>
                                        </MudTooltip>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <SourceLink Url="@docs[0].SourceUrl" Class="mt-2" />
                }
            </MudTabPanel>
        }
    </MudTabs>
}

@code {
    private const string StorageKey = "mln-group";

    private sealed record CategoryInfo(ScheduleCategory Kind, string Title, string Icon);

    private static readonly CategoryInfo[] Categories =
    {
        new(ScheduleCategory.Classes, "Заняття", Icons.Material.Filled.CalendarMonth),
        new(ScheduleCategory.Exams, "Сесія", Icons.Material.Filled.FactCheck),
    };

    private sealed record Week(ScheduleTable Table, int Column, List<IGrouping<string, ScheduleTableRow>> Days);

    private sealed record Exam(string When, string What);

    [Parameter]
    [SupplyParameterFromQuery(Name = "group")]
    public string? Group { get; set; }

    private readonly List<ScheduleDoc> _docs = new();
    private readonly List<ScheduleGroupRef> _groups = new();
    private readonly Dictionary<string, List<string>> _parsed = new(StringComparer.Ordinal);
    private readonly List<Exam> _exams = new();

    private Week? _weekly;
    private string? _loadedFor;
    private string? _note;
    private Severity _noteSeverity = Severity.Info;
    private bool _busy = true;

    private string PageName => Group is { Length: > 0 } group
        ? $"Розклад {group}"
        : "Розклад занять і сесії";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _docs.AddRange(await Http.GetFromJsonAsync<List<ScheduleDoc>>("data/schedule.json") ?? new());
        }
        catch (HttpRequestException)
        {
            _note = "data/schedule.json ще не згенеровано (dotnet run --project tools/Scraper).";
            _noteSeverity = Severity.Warning;
        }
        catch (Exception ex)
        {
            _note = $"Не вдалося прочитати schedule.json: {ex.Message}";
            _noteSeverity = Severity.Error;
        }

        _groups.AddRange(await Content.TryGetScheduleGroupsAsync() ?? new());

        foreach (var reference in _groups)
        {
            if (!_parsed.TryGetValue(reference.File, out var list))
                _parsed[reference.File] = list = new List<string>();

            list.Add(reference.Group);
        }

        _busy = false;

        if (string.IsNullOrEmpty(Group) && await ReadRememberedAsync() is { Length: > 0 } remembered)
        {
            Nav.NavigateTo($"schedule?group={Uri.EscapeDataString(remembered)}", replace: true);
            return;
        }

        await LoadGroupAsync();
    }

    protected override Task OnParametersSetAsync() =>
        _busy || Group == _loadedFor ? Task.CompletedTask : LoadGroupAsync();

    private async Task LoadGroupAsync()
    {
        _loadedFor = Group;
        _weekly = null;
        _exams.Clear();

        if (string.IsNullOrEmpty(Group))
            return;

        var wanted = Canonical(Group);

        foreach (var reference in _groups.Where(g => Canonical(g.Group) == wanted))
        {
            var table = await Content.TryGetScheduleTableAsync(reference.File);
            if (table is null)
                continue;

            if (table.IsWeekly)
            {
                var days = table.Rows
                    .Where(r => r.CellOf(reference.Column).Length > 0)
                    .GroupBy(r => r.Day)
                    .ToList();

                if (days.Count > 0)
                    _weekly ??= new Week(table, reference.Column, days);
            }
            else
            {
                _exams.AddRange(table.Rows
                    .Where(r => r.CellOf(reference.Column).Length > 0)
                    .Select(r => new Exam(r.Label, r.CellOf(reference.Column))));
            }
        }
    }

    private static string[] Parts(string cell) =>
        cell.Split("; ", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private static string Canonical(string group)
    {
        var end = group.TrimEnd().Length;
        while (end > 0 && char.IsLetter(group[end - 1]))
            end--;

        return end > 0 && char.IsDigit(group[end - 1]) ? group[..end] : group;
    }

    private Task<IEnumerable<string>> SearchGroupsAsync(string? value, CancellationToken ct)
    {
        var all = _groups
            .GroupBy(g => Canonical(g.Group))
            .Select(g => g.OrderByDescending(x => x.Group.Length).First().Group)
            .OrderBy(g => g, StringComparer.Ordinal);

        return Task.FromResult(string.IsNullOrWhiteSpace(value)
            ? all
            : all.Where(g => g.Contains(value.Trim(), StringComparison.OrdinalIgnoreCase)));
    }

    private async Task SelectGroupAsync(string? group)
    {
        await RememberAsync(group);

        Nav.NavigateTo(string.IsNullOrWhiteSpace(group)
            ? "schedule"
            : $"schedule?group={Uri.EscapeDataString(group)}");
    }

    private async Task<string?> ReadRememberedAsync()
    {
        try
        {
            return await JS.InvokeAsync<string?>("mlnStore.get", StorageKey);
        }
        catch (JSException)
        {
            return null;
        }
    }

    private async Task RememberAsync(string? group)
    {
        try
        {
            await JS.InvokeVoidAsync("mlnStore.set", StorageKey, group);
        }
        catch (JSException)
        {
        }
    }
}
