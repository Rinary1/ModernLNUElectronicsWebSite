@page "/about"
@page "/about/{Slug}"
@using System.Net.Http.Json
@using WebSite.Data
@using WebSite.Search
@inject HttpClient Http
@inject MirrorContentClient Content

@if (Slug is not null)
{
    <MudButton Href="about" Variant="Variant.Text" Color="Color.Primary" Class="mb-4"
               StartIcon="@Icons.Material.Filled.ArrowBack">
        Про факультет
    </MudButton>

    <MirrorSectionView Group="@MirrorCatalog.About"
                       Title="Про факультет"
                       Description="Історія, цілі, лабораторії, міжнародна співпраця та випускники факультету."
                       Slug="@Slug" />
}
else
{
<PageMeta Title="Про факультет"
          Description="Факультет електроніки та комп'ютерних технологій ЛНУ ім. Івана Франка: освітні програми бакалаврату й магістратури, кафедри, партнери."
          Canonical="@($"{SiteUrls.Origin}/about/introduction/")" />

<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true" Class="fw-600">Про факультет</MudText>

<div class="d-flex flex-wrap gap-2 mb-6">
    @foreach (var reference in MirrorCatalog.ListedIn(MirrorCatalog.About))
    {
        <MudChip T="string"
                 Href="@($"about/{reference.Slug}")"
                 Variant="Variant.Outlined"
                 Color="Color.Default"
                 Size="Size.Small"
                 Class="ma-0">
            @reference.Title
        </MudChip>
    }
</div>

<section class="about-block">
    <MudText Typo="Typo.body1" Class="about-lead mb-3">
        Факультет електроніки та комп'ютерних технологій Львівського національного університету
        імені Івана Франка готує бакалаврів і магістрів у двох галузях - інформаційні технології
        та інжиніринг. Це і програмна інженерія з комп'ютерними науками, і електроніка з
        комп'ютерними системами, сенсорикою та мікро- і наносистемною технікою.
    </MudText>
    <MudText Typo="Typo.body1" Class="about-lead mb-3">
        Факультет розташований на вулиці Драгоманова, 50 у Львові;
        освітні програми ведуться разом із ІТ-компаніями міста, тому частина курсів і практик
        іде на їхніх майданчиках.
    </MudText>

    <SourceLink Url="@($"{SiteUrls.Origin}/about/introduction/")" Class="mb-4" />
</section>

<MudDivider Class="my-8" />

<section class="about-block">
    <MudText Typo="Typo.h5" HtmlTag="h2" Class="fw-600 mb-3">Освітні програми</MudText>

    <MudGrid Spacing="3">
        @foreach (var level in Levels)
        {
            <MudItem xs="12" md="6">
                <MudPaper Outlined="true" Class="pa-4" Style="height:100%">
                    <MudText Typo="Typo.subtitle1" HtmlTag="h3" Class="fw-600 mb-2">@level.Title</MudText>
                    <ul class="about-list">
                        @foreach (var programme in level.Programmes)
                        {
                            <li>@programme</li>
                        }
                    </ul>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>

    <MudButton Href="applicants/osvitni-programy" Variant="Variant.Text" Color="Color.Primary"
               Class="mt-3" EndIcon="@Icons.Material.Filled.ArrowForward">
        Усі освітні програми
    </MudButton>
</section>

<MudDivider Class="my-8" />

<section class="about-block">
    <MudText Typo="Typo.h5" HtmlTag="h2" Class="fw-600 mb-3">Структура</MudText>

    @if (_departments.Count > 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
            @_departments.Count кафедр і лабораторій, @_staffCount співробітників у дзеркалі.
        </MudText>

        <div class="d-flex flex-wrap gap-2">
            @foreach (var department in _departments)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ma-0"
                         Href="@(department.Url is null ? "departments" : $"departments/{SiteUrls.Slug(department.Url)}")">
                    @department.Title
                </MudChip>
            }
        </div>
    }
    else
    {
        <MudText Class="mud-text-secondary">Дані про підрозділи ще не перенесені.</MudText>
    }
</section>

<MudDivider Class="my-8" />

<section class="about-block">
    <MudText Typo="Typo.h5" HtmlTag="h2" Class="fw-600 mb-3">Що це за сайт</MudText>

    <MudText Typo="Typo.body1" Class="about-lead mb-3">
        Це неофіційне дзеркало сайту факультету. Воно бере ті самі дані з
        <MudLink Href="@SiteUrls.Origin" Target="_blank" rel="noopener">electronics.lnu.edu.ua</MudLink>
        і показує їх зручніше: наскрізний пошук по текстах (а не лише по заголовках),
        розклад занять таблицею замість PDF, темна тема й нормальна верстка на телефоні.
        Сайт працює й без мережі - після першого відкриття.
    </MudText>

    <MudText Typo="Typo.body1" Class="about-lead mb-3">
        Дані оновлюються автоматично кожні кілька годин, тож дзеркало може трохи відставати
        від оригіналу - на кожній сторінці є посилання на першоджерело, і саме воно
        лишається авторитетним. Офіційних оголошень, документів і рішень тут не публікують.
    </MudText>
</section>

<MudDivider Class="my-8" />

<section class="about-block">
    <MudText Typo="Typo.h5" HtmlTag="h2" Class="fw-600 mb-3">Наші партнери</MudText>

    @if (_busy)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
    }
    else if (_note is not null)
    {
        <MudAlert Severity="@_noteSeverity" Dense="true" Class="mb-4">@_note</MudAlert>
    }
    else
    {
        <MudGrid Spacing="3">
            @foreach (var partner in _partners)
            {
                <MudItem xs="12" md="6">
                    <MudPaper Outlined="true" Class="pa-4" Style="height:100%">
                        <div class="partner-head">
                            @if (partner.LogoUrl is not null)
                            {
                                <span class="partner-logo">
                                    <img src="@partner.LogoUrl" alt="@partner.Name" loading="lazy" />
                                </span>
                            }
                            @if (partner.Url is not null)
                            {
                                <MudLink Href="@partner.Url" Target="_blank" rel="noopener"
                                         Typo="Typo.subtitle1" Class="fw-600">@partner.Name</MudLink>
                            }
                            else
                            {
                                <MudText Typo="Typo.subtitle1" Class="fw-600">@partner.Name</MudText>
                            }
                        </div>
                        <p class="partner-desc">@partner.Description</p>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>

        <SourceLink Url="@($"{SiteUrls.Origin}/about/introduction/")" Class="mt-3" />
    }
</section>

}

@code {
    [Parameter]
    public string? Slug { get; set; }

    private sealed record Level(string Title, string[] Programmes);

    private static readonly Level[] Levels =
    {
        new("Бакалаврат",
        [
            "F2 - Інженерія програмного забезпечення",
            "F3 - Комп'ютерні науки",
            "F6 - Інформаційні системи і технології",
            "G5 - Електроніка, електронні комунікації, приладобудування та радіотехніка",
            "G7 - Автоматизація, комп'ютерно-інтегровані технології та робототехніка",
            "176 - Мікро- та наносистемна техніка",
        ]),
        new("Магістратура",
        [
            "F2 - Комп'ютерні науки: інформаційні технології проектування, системне проектування, системи штучного інтелекту, спеціалізовані комп'ютерні системи",
            "G5 - Електроніка, електронні комунікації, приладобудування та радіотехніка: прилади та матеріали сенсорної електроніки",
        ]),
    };

    private sealed record Department(string Title, string? Url);

    private readonly List<Partner> _partners = new();
    private readonly List<Department> _departments = new();

    private int _staffCount;
    private string? _note;
    private Severity _noteSeverity = Severity.Info;
    private bool _busy = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var items = await Http.GetFromJsonAsync<List<Partner>>("data/partners.json");
            _partners.AddRange(items ?? new());
        }
        catch (HttpRequestException)
        {
            _note = "data/partners.json ще не згенеровано (dotnet run --project tools/Scraper).";
            _noteSeverity = Severity.Warning;
        }
        catch (Exception ex)
        {
            _note = $"Не вдалося прочитати partners.json: {ex.Message}";
            _noteSeverity = Severity.Error;
        }
        finally
        {
            _busy = false;
        }

        try
        {
            var staff = await Http.GetFromJsonAsync<List<StaffItem>>("data/staff.json") ?? new();

            _staffCount = staff.Select(s => s.ProfileUrl).Distinct(StringComparer.Ordinal).Count();
            _departments.AddRange(staff
                .GroupBy(s => s.Group.Title)
                .Select(g => new Department(g.Key, g.First().Group.Url))
                .OrderBy(d => d.Title, UkrainianAlphabet.Comparer));
        }
        catch (HttpRequestException)
        {
        }
    }
}
