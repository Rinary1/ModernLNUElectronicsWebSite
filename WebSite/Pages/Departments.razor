@page "/departments"
@using System.Net.Http.Json
@using WebSite.Data
@inject HttpClient Http

<PageMeta Title="Кафедри"
          Description="Кафедри та лабораторії факультету електроніки та комп'ютерних технологій ЛНУ: склад, завідувачі, сторінки підрозділів."
          Canonical="@($"{SiteUrls.Origin}/about/departments/")" />

<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true" Class="fw-600">Кафедри</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    Кафедри факультету. Склад формується зі списку співробітників.
</MudText>

@if (_busy)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}
else if (_note is not null)
{
    <MudAlert Severity="@_noteSeverity" Dense="true" Class="mb-4">@_note</MudAlert>
}
else
{
    <MudGrid Spacing="3">
        @foreach (var d in _departments)
        {
            <MudItem xs="12" md="6" Class="d-flex">
                <MudPaper Outlined="true" Class="pa-4 d-flex flex-column flex-grow-1">
                    <MudText Typo="Typo.h6" HtmlTag="h2" Class="fw-600">@d.Title</MudText>

                    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                        @d.Count співробітників@(d.Head is not null ? $" · завідувач: {d.Head}" : string.Empty)
                    </MudText>

                    <MudSpacer />

                    <div class="d-flex gap-3 mt-3 flex-wrap">
                        <MudButton Href="@($"staff?q={Uri.EscapeDataString(d.Title)}")"
                                   Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Groups">
                            Склад кафедри
                        </MudButton>
                        @if (d.Url is not null)
                        {
                            <MudButton Href="@($"departments/{SiteUrls.Slug(d.Url)}")"
                                       Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Article">
                                Про підрозділ
                            </MudButton>
                        }
                    </div>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private sealed record DepartmentCard(string Title, string? Url, int Count, string? Head);

    private readonly List<DepartmentCard> _departments = new();
    private string? _note;
    private Severity _noteSeverity = Severity.Info;
    private bool _busy = true;

    private static readonly StaffGroupKind[] DepartmentKinds =
    {
        StaffGroupKind.DepartmentOptoelectronics,
        StaffGroupKind.DepartmentRadioelectronics,
        StaffGroupKind.DepartmentRadiophysics,
        StaffGroupKind.DepartmentSensorElectronics,
        StaffGroupKind.DepartmentSystemDesign,
        StaffGroupKind.DepartmentPhysicalBioelectronics,
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var staff = await Http.GetFromJsonAsync<List<StaffItem>>("data/staff.json") ?? new();

            _departments.AddRange(staff
                .Where(s => DepartmentKinds.Contains(s.Group.Kind))
                .GroupBy(s => s.Group.Title)
                .Select(g => new DepartmentCard(
                    Title: g.Key,
                    Url: g.First().Group.Url,
                    Count: g.Count(),
                    Head: g.FirstOrDefault(s => s.Position.Contains("завідувач", StringComparison.OrdinalIgnoreCase))?.FullName)));
        }
        catch (HttpRequestException)
        {
            _note = "data/staff.json ще не згенеровано (dotnet run --project tools/Scraper).";
            _noteSeverity = Severity.Warning;
        }
        catch (Exception ex)
        {
            _note = $"Не вдалося прочитати staff.json: {ex.Message}";
            _noteSeverity = Severity.Error;
        }
        finally
        {
            _busy = false;
        }
    }
}
