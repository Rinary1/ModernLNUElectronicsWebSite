@page "/administration"
@using System.Net.Http.Json
@using WebSite.Data
@inject HttpClient Http

<PageMeta Title="Адміністрація"
          Description="Деканат і Рада факультету електроніки та комп'ютерних технологій ЛНУ ім. Івана Франка."
          Canonical="@($"{SiteUrls.Origin}/about/administration/")" />

<MudText Typo="Typo.h4" HtmlTag="h1" GutterBottom="true" Class="fw-600">Адміністрація</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    Деканат і Рада факультету з <code>/about/administration/</code> (зокрема студентська частина ради,
    якої немає у списку співробітників).
</MudText>

<MudTextField @bind-Value="_query"
              Immediate="true"
              Placeholder="Пошук за прізвищем..."
              Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search"
              Clearable="true"
              Variant="Variant.Outlined"
              Margin="Margin.Dense"
              Class="mb-4" />

@if (_busy)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}
else if (_note is not null)
{
    <MudAlert Severity="@_noteSeverity" Dense="true" Class="mb-4">@_note</MudAlert>
}
else
{
    <MudText Typo="Typo.subtitle2" Class="mud-text-secondary mb-2">
        Показано @Filtered().Count() із @_all.Count
    </MudText>

    <SourceLink Url="https://electronics.lnu.edu.ua/about/administration/" Class="mb-4" />

    @foreach (var section in _sections)
    {
        var people = Filtered().Where(p => p.Section == section.Kind).ToList();
        if (people.Count == 0)
        {
            continue;
        }

        <div class="mt-6">
            <MudText Typo="Typo.h6" HtmlTag="h2" Class="fw-600 mb-2">@section.Title</MudText>
            <MudDivider Class="mb-3" />

            @foreach (var roleGroup in people.GroupBy(p => (p.Role, p.Rank)))
            {
                <div class="mb-3">
                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">
                        @roleGroup.Key.Role@(roleGroup.Key.Rank is { } r ? $" · {r}" : string.Empty)
                    </MudText>
                    <MudGrid Spacing="2" Class="mt-1">
                        @foreach (var person in roleGroup)
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudPaper Outlined="true" Class="pa-3" Style="height:100%">
                                    @if (person.ProfileUrl is not null)
                                    {
                                        <MudLink Href="@($"staff/{SiteUrls.Slug(person.ProfileUrl)}")" Typo="Typo.subtitle2">
                                            @person.Name
                                        </MudLink>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.subtitle2">@person.Name</MudText>
                                    }
                                    @if (person.RoleDetail is not null)
                                    {
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
                                            @person.RoleDetail
                                        </MudText>
                                    }
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>
                </div>
            }
        </div>
    }
}

@code {
    private sealed record SectionInfo(AdministrationSection Kind, string Title);

    private readonly SectionInfo[] _sections =
    {
        new(AdministrationSection.DeansOffice, "Деканат"),
        new(AdministrationSection.Council, "Рада факультету"),
    };

    private readonly List<AdministrationPerson> _all = new();
    private string? _query;
    private string? _note;
    private Severity _noteSeverity = Severity.Info;
    private bool _busy = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var items = await Http.GetFromJsonAsync<List<AdministrationPerson>>("data/administration.json");
            _all.AddRange(items ?? new());
        }
        catch (HttpRequestException)
        {
            _note = "data/administration.json ще немає - згенеруйте його: dotnet run --project tools/Scraper";
            _noteSeverity = Severity.Info;
        }
        catch (Exception ex)
        {
            _note = $"Не вдалося прочитати administration.json: {ex.Message}";
            _noteSeverity = Severity.Error;
        }
        finally
        {
            _busy = false;
        }
    }

    private IEnumerable<AdministrationPerson> Filtered()
    {
        if (string.IsNullOrWhiteSpace(_query))
            return _all;

        var q = _query.Trim();
        return _all.Where(p =>
            p.Name.Contains(q, StringComparison.OrdinalIgnoreCase)
            || p.Role.Contains(q, StringComparison.OrdinalIgnoreCase)
            || (p.Rank?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
    }
}
